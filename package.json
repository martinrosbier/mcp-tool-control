{
  "name": "mcp-tool-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small TypeScript MCP foundation for controlled tool execution.",
  "main": "dist/runtime.js",
  "types": "dist/runtime.d.ts",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": { "build": "tsc", "check": "npm run typecheck && npm test && npm run build", "dev": "tsx src/server.ts", "start": "node dist/server.js", "typecheck": "tsc --noEmit", "test": "vitest run", "test:watch": "vitest" },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.30.0", "zod": "^3.24.3" },
  "devDependencies": { "@types/node": "^22.19.18", "tsx": "^4.23.13", "typescript": "^5.8.3", "vitest": "^4.1.11" },
  "engines": { "node": ">=20" }
}
