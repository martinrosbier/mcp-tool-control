{
  "name": "mcp-tool-control",
  "version": "1.2.0",
  "type": "module",
  "description": "A small TypeScript MCP foundation for controlled tool execution.",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "approval-workflow",
    "controlled-execution",
    "security",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinrosbier/mcp-tool-control.git"
  },
  "homepage": "https://github.com/martinrosbier/mcp-tool-control#readme",
  "bugs": "https://github.com/martinrosbier/mcp-tool-control/issues",
  "main": "dist/runtime.js",
  "types": "dist/runtime.d.ts",
  "bin": {
    "mcp-tool-control": "dist/server.js",
    "mcp-tool-control-host": "dist/host-cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
