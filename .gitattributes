# Enforce LF line endings for text files on every platform, including Windows.
# Matches .editorconfig (end_of_line = lf) and Prettier (endOfLine = "lf").
* text=auto eol=lf

# Binary files: never normalize line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
